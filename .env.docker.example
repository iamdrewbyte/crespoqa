# Copy to .env (start.sh does this for you) and edit. Every line is optional.

# Who can reach it. 127.0.0.1 = only this machine. 0.0.0.0 = anyone on your network (then turn login ON below).
CRESPOQA_PUBLISH=127.0.0.1
CRESPOQA_PORT=8000

# Login. off = anyone who can open the page is a full user. on = accounts + roles.
CRESPOQA_AUTH=off
# With CRESPOQA_AUTH=on, this creates the first editor account on first start (use a long password).
CRESPOQA_ADMIN_USER=
CRESPOQA_ADMIN_PASSWORD=
# Set true when you put HTTPS in front (reverse proxy).
CRESPOQA_COOKIE_SECURE=false

# The AI model, as published by Ollama. A bigger one is sharper (needs more RAM/VRAM).
AI_MODEL=qwen2.5:7b-instruct
