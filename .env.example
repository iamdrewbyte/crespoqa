# Directory for per-job working files (random UUID subfolders). Default: system temp.
CRESPOQA_TEMP_DIR=
CRESPOQA_MAX_FILE_MB=50
CRESPOQA_DOC_TIMEOUT_S=180
# Path to soffice (LibreOffice). Leave blank to auto-detect; layout checks are skipped if absent.
CRESPOQA_SOFFICE=
CRESPOQA_LOG_DIR=logs
CRESPOQA_LOG_LEVEL=INFO
CRESPOQA_WORKERS=1
CRESPOQA_TTL_MINUTES=30
CRESPOQA_HOST=127.0.0.1
CRESPOQA_PORT=8000
CRESPOQA_DB=data/crespoqa.db
# Set true when served over HTTPS (reverse proxy)
CRESPOQA_COOKIE_SECURE=false
CRESPOQA_SESSION_HOURS=8
# --- Optional local AI review (review-only; never edits documents) ---
AI_ENABLED=false
# Any OpenAI-compatible local endpoint: Ollama (http://localhost:11434/v1), llama.cpp server, vLLM.
AI_BASE_URL=http://localhost:11434/v1
# Official Qwen instruct model you have pulled, e.g. the tag shown by `ollama list`. Never hard-coded.
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_S=120
AI_CHUNK_CHARS=12000
AI_MAX_CHUNKS=30
# Refuses non-loopback/private endpoints unless true (report text must stay on your machine)
AI_ALLOW_REMOTE=false
# Appended to the file name before .docx. Empty = processed files keep their original name.
CRESPOQA_OUTPUT_SUFFIX=
# Login. off = anyone who can reach the page is a full user (fine on your own laptop). on = accounts + roles.
CRESPOQA_AUTH=off
# Write each finished file straight into this folder, replacing a file of the same name (laptop use).
# Empty = only browser downloads. The browser itself adds (1), (2) to download names; this avoids that.
CRESPOQA_SAVE_DIR=
